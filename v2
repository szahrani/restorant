<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تجريبي لاونج | Tajribi Lounge V2</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Tajawal', sans-serif;
      background: #f3eee7;
      color: #2b2b2b;
      margin: 0;
      padding: 0;
      direction: rtl;
      overflow-x: hidden;
      animation: fadeIn 1s ease-in-out;
    }
    header {
      text-align: center;
      padding: 20px;
      position: relative;
    }
    .logo {
      font-size: 36px;
      color: #c7a35e;
      font-weight: 700;
      letter-spacing: 2px;
    }
    .english-btn {
      position: absolute;
      left: 20px;
      top: 30px;
      background: none;
      border: none;
      color: #c7a35e;
      font-weight: 500;
      font-size: 16px;
      cursor: pointer;
      transition: 0.3s;
    }
    .english-btn:hover {
      color: #b89548;
    }
    .tabs {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 20px auto;
      flex-wrap: wrap;
    }
    .tab-btn {
      background: #fff;
      border: 1px solid #c7a35e;
      color: #c7a35e;
      padding: 10px 20px;
      border-radius: 25px;
      cursor: pointer;
      transition: 0.3s;
    }
    .tab-btn.active, .tab-btn:hover {
      background: #c7a35e;
      color: #fff;
    }
    .tab-content {
      display: none;
      max-width: 700px;
      margin: auto;
      animation: fade 0.5s ease;
    }
    .tab-content.active {
      display: block;
    }
    .menu-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #e0d9cd;
      padding: 15px 0;
    }
    .menu-item:last-child { border-bottom: none; }
    .menu-item img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      margin-left: 15px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      border: 2px solid #f0e7d8;
    }
    .menu-text {
      flex: 1;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .menu-text span {
      font-size: 18px;
    }
    footer {
      text-align: center;
      color: #999;
      margin-top: 40px;
      font-size: 14px;
    }
    @keyframes fade {
      from {opacity: 0;}
      to {opacity: 1;}
    }
    @keyframes fadeIn {
      from {opacity: 0; transform: translateY(10px);}
      to {opacity: 1; transform: translateY(0);}
    }
  </style>
</head>
<body>
  <header>
    <button class="english-btn">🇬🇧 English</button>
    <div class="logo">تجريبي لاونج</div>
  </header>

  <div class="tabs">
    <button class="tab-btn active" onclick="openTab('appetizers')">المقبلات</button>
    <button class="tab-btn" onclick="openTab('mains')">الأطباق الرئيسية</button>
    <button class="tab-btn" onclick="openTab('desserts')">الحلويات</button>
    <button class="tab-btn" onclick="openTab('drinks')">المشروبات</button>
  </div>

  <div id="appetizers" class="tab-content active">
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1603133872878-684f208fb84b" alt="فتوش"><div class="menu-text"><span>فتوش</span><span>28 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1617196034846-2e1f6db0d5f1" alt="تبولة"><div class="menu-text"><span>تبولة</span><span>26 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1589308078052-006afa8e2c32" alt="حمص بالطحينة"><div class="menu-text"><span>حمص بالطحينة</span><span>22 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1565958011705-ec4f27cf9f86" alt="سبرينغ رول خضار"><div class="menu-text"><span>سبرينغ رول خضار</span><span>24 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1600891964599-f61ba0e24092" alt="بطاطس ترافل"><div class="menu-text"><span>بطاطس ترافل</span><span>32 ريال</span></div></div>
  </div>

  <div id="mains" class="tab-content">
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1600628422011-9b3cf62f2bb0" alt="كباب"><div class="menu-text"><span>كباب مشوي على الفحم</span><span>68 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1604908176997-3b45e21f47c6" alt="دجاج تكا"><div class="menu-text"><span>دجاج تكا</span><span>59 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1625943554214-cbe40b74ff78" alt="أرز برياني"><div class="menu-text"><span>أرز برياني</span><span>52 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1617196034715-0f3f2c54e59a" alt="سلمون مشوي"><div class="menu-text"><span>سلمون مشوي</span><span>89 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1617196035025-b1d8cbcb6b3b" alt="ستيك تندرلوين"><div class="menu-text"><span>ستيك تندرلوين</span><span>120 ريال</span></div></div>
  </div>

  <div id="desserts" class="tab-content">
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1605478371199-09d71a3b9ef4" alt="تشيز كيك الزعفران"><div class="menu-text"><span>تشيز كيك الزعفران</span><span>38 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1625398407790-3ee71bb43f1e" alt="كنافة"><div class="menu-text"><span>كنافة بالقشطة</span><span>32 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1589307004394-7cc96e0b7a5d" alt="مولتن شوكليت"><div class="menu-text"><span>مولتن شوكليت</span><span>35 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1606312615583-07fa7cb83e19" alt="آيس كريم الفستق"><div class="menu-text"><span>آيس كريم الفستق</span><span>28 ريال</span></div></div>
  </div>

  <div id="drinks" class="tab-content">
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87" alt="قهوة تركية"><div class="menu-text"><span>قهوة تركية</span><span>18 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1511920170033-f8396924c348" alt="لاتيه كراميل"><div class="menu-text"><span>لاتيه كراميل</span><span>24 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1623206836112-2664b4a5bba2" alt="موهيتو نعناع"><div class="menu-text"><span>موهيتو نعناع</span><span>29 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1587019155887-2052f20e6f32" alt="شاي مغربي"><div class="menu-text"><span>شاي مغربي</span><span>22 ريال</span></div></div>
    <div class="menu-item"><img src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461" alt="مياه معدنية"><div class="menu-text"><span>مياه معدنية</span><span>8 ريال</span></div></div>
  </div>

  <footer>
    © 2025 Tajribi Lounge | Designed by Eng. Saud Al-Zahrani
  </footer>

  <script>
    function openTab(tabId) {
      const tabs = document.querySelectorAll('.tab-content');
      const buttons = document.querySelectorAll('.tab-btn');
      tabs.forEach(t => t.classList.remove('active'));
      buttons.forEach(b => b.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      event.target.classList.add('active');
    }
  </script>
</body>
</html>

